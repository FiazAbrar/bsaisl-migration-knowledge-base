# navigator-bot settings. Copy this file to .env and fill in the values (on a host: its settings page).
# Never commit .env or paste its values into chat. Checked at start-up by src/config.ts.

# --- Secrets the bot derives its own keys from ---
# Turns WhatsApp numbers, Telegram ids and web sessions into codes before anything is stored.
# Required in production: a long random string (at least 32 characters), for example from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later makes the bot forget every user.
USER_HASH_SECRET=
# Optional key for signing web session cookies. Empty = derived from USER_HASH_SECRET.
WEB_SESSION_SECRET=

# --- Public address of this server, without https:// (an ngrok static domain, or the cloud host) ---
# Used to register the Telegram webhook, check Turnstile tokens and link the privacy page.
PUBLIC_DOMAIN=

# --- Knowledge base (read-only) ---
# Leave empty: the bot uses the repository it sits in. Set a path only to use another copy.
KB_DIR=
# On a server: the bot pulls the guides straight from GitHub and re-checks every KB_SYNC_MINUTES,
# so knowledge-base pushes go live without a redeploy. Leave KB_REPO empty on a PC inside the repository.
# KB_REPO=https://github.com/FiazAbrar/bsaisl-migration-knowledge-base.git
KB_REPO=
KB_BRANCH=main
KB_SYNC_MINUTES=15
# Only if the repository becomes private: a read-only GitHub token (fine-grained, Contents: read)
KB_GITHUB_TOKEN=
# A commit to load even though the safety check refuses it (a guide renamed or cut on purpose).
# First 7+ characters of the commit. Remove it again once /health shows that commit.
KB_ACCEPT_COMMIT=

# --- Database: memory, duplicate checks, abuse counters ---
# Empty: an embedded database in data/pglite (a PC, or a server with a disk).
# On hosts whose disk is wiped at restart (Render's free plan): a Postgres connection string, e.g. Neon's
# pooled address: postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- WhatsApp Cloud API (docs/SETUP-META.md). Leave all four empty to switch WhatsApp off. ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token
WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret (the older name META_APP_SECRET also works)
WHATSAPP_APP_SECRET=
# Any random string; the same value goes into the webhook settings in Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v27.0

# --- Telegram (optional; README.md > Telegram). Token from @BotFather ---
TELEGRAM_BOT_TOKEN=
# Optional: the secret Telegram sends with each update. Empty = derived from the token.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# --- Web chat (README.md > Web chat). The page is served at https://<PUBLIC_DOMAIN>/ ---
# off hides the page and its API
WEB_CHAT=on
# Cloudflare Turnstile bot check (free). Set both before the page goes public.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# The header your proxy puts the visitor's address in: X-Forwarded-For (Render, ngrok, most cloud hosts)
# or CF-Connecting-IP (Cloudflare). Empty = no proxy.
PROXY_IP_HEADER=
# Which proxies that header is believed from (comma-separated addresses or ranges).
# Empty = this machine and private networks, which suits ngrok and most cloud hosts.
TRUSTED_PROXIES=

# --- Abuse limits and daily AI budgets (src/guard/guard.ts). Empty = the lenient testing defaults.
# Suggested public values: web 6 a minute / 40 a day, WhatsApp 20 / 150, Telegram 15 / 100,
# IP 200 a day, 20 sessions an hour, all web visitors 60 a minute.
GUARD_WEB_PER_MINUTE=
GUARD_WEB_PER_DAY=
GUARD_WHATSAPP_PER_MINUTE=
GUARD_WHATSAPP_PER_DAY=
GUARD_TELEGRAM_PER_MINUTE=
GUARD_TELEGRAM_PER_DAY=
GUARD_IP_PER_DAY=
GUARD_SESSIONS_PER_HOUR=
GUARD_WEB_ALL_PER_MINUTE=
GUARD_COMMANDS_PER_MINUTE=
BUDGET_WEB_USD=
BUDGET_WHATSAPP_USD=
BUDGET_TELEGRAM_USD=

# --- AI answers through OpenRouter (empty key = test mode: replies list the closest guide sections) ---
OPENROUTER_API_KEY=
# OpenRouter model ids, e.g. provider/model-name. LLM_MODEL is required with a key.
LLM_MODEL=
# Used if the main model fails or times out
LLM_FALLBACK_MODEL=
# Small, cheap model for the profile card and the running summary (empty = LLM_MODEL)
LLM_SMALL_MODEL=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=900
# How much of the conversation the AI sees (tokens), besides the profile card and summary
CONTEXT_TOKEN_BUDGET=3000
# Comma-separated models for `npm run eval`
EVAL_MODELS=

# --- Error alerts (sentry.io, free plan). Empty = errors are only logged. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Server ---
# PORT is usually set by the host (8000 if not). LOG_LEVEL: debug, info (default), warn, error.
PORT=
LOG_LEVEL=info
