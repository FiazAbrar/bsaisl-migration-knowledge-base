# navigator-bot settings. Copy this file to .env and fill in the values.
# Never commit .env or paste its values into chat.

# --- Knowledge base (read-only) ---
# Leave empty: the bot uses the repository it sits in. Set a path only to use another copy.
KB_DIR=
# On a server: the bot pulls the guides straight from GitHub and re-checks every KB_SYNC_MINUTES,
# so knowledge-base pushes go live without a redeploy. Leave KB_REPO empty on a PC inside the repository.
# KB_REPO=https://github.com/FiazAbrar/bsaisl-migration-knowledge-base.git
KB_REPO=
KB_BRANCH=main
KB_SYNC_MINUTES=15
# Only if the repository becomes private: a read-only GitHub token (fine-grained, Contents: read)
KB_GITHUB_TOKEN=

# --- Meta / WhatsApp Cloud API (docs/SETUP-META.md) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token
WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret
META_APP_SECRET=
# Any random string; the same value goes into the webhook settings in Meta
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v27.0

# --- Telegram (optional; README.md > Telegram). Token from @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- Public address of the webhook, without https:// (e.g. an ngrok static domain) ---
PUBLIC_DOMAIN=

# --- AI model via an OpenAI-compatible API (e.g. OpenRouter) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Comma-separated models for the comparison test
EVAL_MODELS=

# --- Testing: your own WhatsApp number, international format without + ---
TEST_RECIPIENT=
