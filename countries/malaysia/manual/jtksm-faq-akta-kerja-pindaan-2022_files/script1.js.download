(function($) {
  "use strict";
  $(function() {
    
    var jtksm1 = {
      
      headerDate: function(d) {
        // update header clock
        setInterval(function() {
          $(d).html(updateDate());        
        },1000);
      },

      search: function() {
        $('body').on('click', '#search-icon', function() {
          var search = $('#search-wrapper');
          search.toggleClass('active');
          if (search.hasClass('active')) {
            search.fadeIn('slow');
            $('#search-icon').addClass('active');
            $('#search-icon').parent().addClass('active');

          } else {
            search.fadeOut('slow');
            $('#search-icon').removeClass('active');
            $('#search-icon').parent().removeClass('active');
          }
        });
        $(".search-block-form #edit-keys").attr("placeholder", "Carian...");
        $(":lang(en) .search-block-form #edit-keys").attr("placeholder", "Search...");
      },

      pageTitle: function() {
        $('.title').appendTo('.page-title')
      },

      contentNavigationBottom: function() {
        var menub = $('.mainnavigation-bottom');
        var menuListb = [];
        var getMenub = menub.find('.navbar-nav a');
        var outputMenub = $('<div />', {
          id: 'content-navigation-menu-b'
        });

        $.each(getMenub, function() {
          //Get all anchor tag
          menuListb.push($(this));
        });
        //Construct our navigation output
        $.each(menuListb, function() {
          $(this).appendTo(outputMenub);
        });
        outputMenub.insertAfter(menub);
        //Loop our newly add anchor tags and show next/prev page
        $.each($('#content-navigation-menu-b a'), function() {
          //$( "#content-navigation-menu .dropdown-toggle" ).remove();
          $("#content-navigation-menu-b").find(".dropdown-toggle").removeAttr('data-toggle');


          if ($(this).hasClass('is-active')) {

            if ($(this).next().attr('href') != $(this).attr('href')) {

              if (!$("#content-navigation-menu-b a.menu-next").length) {
                $(this).next().addClass('menu-visible menu-next')
              }
            }

          }

        });
        if ($("#content-navigation-menu-b a.menu-next").length) {
          $('body').addClass("hav-nextpage");
        } else {
          $('body').addClass("havno-nextpage");
        }
      },

      kalkulatorTidakCukupSebulan: function() {
        $('#btn-calculator').on('click', function() {

          var gaji_sebulan = $('#edit-gaji-sebulan').val();
          //var kiraan_untuk_bulan = $('#edit-kiraan-untuk-bulan-').val();
          var kiraan_untuk_bulan = $('#bulan').val();
          var bil_hari_kerja_sebenar = $('#edit-bilangan-hari-kerja-sebenar').val();

          var total = +Math.abs((gaji_sebulan) * (bil_hari_kerja_sebenar)) / kiraan_untuk_bulan
            $('#edit-jumlah-rm-').val(total.toFixed(2));
          //alert (kiraan_untuk_bulan);

        });

        $('#btn-batal').on('click', function() {

          $(':input','form#webform-submission-kalkulator-bekerja-tidak-cukup-s-node-404-add-form')
            .not(':button, :submit, :reset, :hidden')
            .val('')
            .removeAttr('checked')
            .removeAttr('selected');

        });

        $('#bulan').on('change', function() {

          $('input#edit-bilangan-hari').val( this.value );
          //alert( this.value );
        });
      },

      kalkulatorGajiGantiNotis: function() {
        $('#btn-calculator-ggn').on('click', function() {

          var gaji_sebulan = $('#edit-ggn-gaji-sebulan').val();
          //var kiraan_untuk_bulan = $('#edit-ggn-bulan-perkhidmatan-ditamatkan-').val();
          var kiraan_untuk_bulan = $('#ggn-bulan').val();
          var bil_hari_notis = $('#edit-ggn-jumlah-hari-notis').val();

          var total = +Math.abs((gaji_sebulan) / (kiraan_untuk_bulan)) * bil_hari_notis;
            $('#edit-jumlah-rm-ggn').val(total.toFixed(2));
            //alert (total);

        });

        $('#btn-batal-ggn').on('click', function() {

          $(':input','form#webform-submission-kalkulator-gaji-ganti-notis-bagi-node-407-add-form')
            .not(':button, :submit, :reset, :hidden')
            .val('')
            .removeAttr('checked')
            .removeAttr('selected');

        });

        $('#ggn-bulan').on('change', function() {

          $('input#edit-ggn-bilangan-hari').val( this.value );
          //alert( this.value );
        });
      },

      kalkulatorGajiGantiNotis2: function() {
        $('#btn-calculator-ggn2').on('click', function() {

          var gaji_sebulan = $('#edit-ggn2-gaji-sebulan').val();
          //var bil_hari = $('#edit-ggn2-bilangan-hari').val();
          var kiraan_untuk_bulan = $('#edit-ggn2-bilangan-hari').val();
          //var hari = $('#edit-ggn2-hari').val();
          //var minggu = $('#edit-ggn2-minggu').val();
          var dateone = $('input#edit-ggn2-tarikh-mula-berkhidmat-').val();
          var datetwo = $('input#edit-ggn2-tarikh-terakhir-berkhidmat-').val();
          dateone = new Date(dateone);
          datetwo = new Date(datetwo); 

          var mili_sec = datetwo.getTime() - dateone.getTime();

          // Convert the milli seconds to Days 
          var days = mili_sec / (1000 * 3600 * 24);
          var months = (days / 365);
          var year = months;
            if (year < 2) {
              year = 28;
            } else if (year >= 2 && year < 5 ) {
              year = 42;
            } else {
              year = 56;
            }

          $('#edit-ggn2-minggu').val(months.toFixed(2));
          $('#edit-ggn2-hari').val(year);

          //var total = +Math.round((gaji_sebulan) / (bil_hari)) * hari * minggu;
          var total = +Math.abs((gaji_sebulan) / (kiraan_untuk_bulan)) * year;
            $('#edit-jumlah-rm-ggn2').val(total.toFixed(2));

          //alert (months);

        });

        $('#btn-batal-ggn2').on('click', function() {

          $(':input','form#webform-submission-kalkulator-gaji-ganti-notis-b-node-408-add-form')
            .not(':button, :submit, :reset, :hidden')
            .val('')
            .removeAttr('checked')
            .removeAttr('selected');

        });

        $('#ggn2-bulan').on('change', function() {

          $('input#edit-ggn2-bilangan-hari').val( this.value );
          //alert( this.value );
        });
      },

      kalkulatorGajiGantiNotis3: function() {

        $('#btn-calculator-ggn3').on('click', function() {
          
          var purata_gaji = $('#edit-ggn3-bilangan-hari').val();
          //var bil_hari = $('input#edit-jumlah-rm-ggn2').val();
          var dateone = $('input#edit-ggn3-tarikh-mula-berkhidmat-').val();
          var datetwo = $('input#edit-ggn3-tarikh-terakhir-berkhidmat-').val();
          dateone = new Date(dateone);
          datetwo = new Date(datetwo); 

          var mili_sec = datetwo.getTime() - dateone.getTime();

          // Convert the milli seconds to Days 
          var days = mili_sec / (1000 * 3600 * 24);
          var months = (days / 365);
          var year = months;
            if (year < 1) {
              year = 0;
            } else if (year >= 1 && year < 2 ) {
                year = 10;
            } else if (year >= 2 && year < 5 ) {
                year = 15;
            } else {
                year = 20;
            }

          $('#edit-ggn3-tempoh-berkhidmat-').val(months.toFixed(2));
          $('#edit-ggn3-purata-gaji-sehari').val(year);

          var total = +Math.abs(purata_gaji / 365) * months * year;
            $('#edit-jumlah-rm-ggn3').val(total.toFixed(2));
          //alert(purata_gaji);

        });

        $('#btn-batal-ggn3').on('click', function() {

          $(':input','form#webform-submission-kalkulator-gaji-ganti-notis-hari-node-409-add-form')
            .not(':button, :submit, :reset, :hidden')
            .val('')
            .removeAttr('checked')
            .removeAttr('selected');

        });
      },

      kalkulatorFaedahPenamatanKerja: function() {
        $('#btn-calculator-fpk').on('click', function() {

          var jumlah_upah = $('#edit-fpk-gaji').val();
          var bil_hari = $('#edit-fpk-hari').val();
          var dateone = $('input#edit-fpk-tarikh-mula-berkhidmat-').val();
          var datetwo = $('input#edit-fpk-tarikh-terakhir-berkhidmat-').val();
          dateone = new Date(dateone);
          datetwo = new Date(datetwo); 

          var mili_sec = datetwo.getTime() - dateone.getTime();

          // Convert the milli seconds to Days 
          var days = mili_sec / (1000 * 3600 * 24);
          var months = (days / 365);
          var year = months;
            if (year < 1) {
              year = 0;
            } else if (year >= 1 && year < 2 ) {
                year = 10;
            } else if (year >= 2 && year < 5 ) {
                year = 15;
            } else {
                year = 20;
            }

          $('#edit-fpk-jumlah-tahun-perkhidmatan').val(year);
          $('#edit-fpk-tempoh-berkhidmat-').val(months.toFixed(2));

          var total = +Math.abs((jumlah_upah) / (bil_hari)) * months * year;
            $('#edit-jumlah-rm-fpk').val(total.toFixed(2));
          //alert(purata_gaji);

        });

        $('#btn-batal-fpk').on('click', function() {

          $(':input','form#webform-submission-kalkulator-faedah-penamatan-kerj-node-473-add-form')
            .not(':button, :submit, :reset, :hidden')
            .val('')
            .removeAttr('checked')
            .removeAttr('selected');

        });
      },

      kalkulatorFaedahPenamatanKerja2: function() {
        $('#btn-calculator-fpk').on('click', function() {

          var gaji = $('#edit-fpk2-gaji').val();
          var bulan = 12;
          var bil_hari_kerja_sebenar = $('#edit-fpk2-bilangan-hari-kerja-sebenar').val();
          var bil_hari = $('#edit-fpk2-hari').val();
          var jumlah_tahun_perkhidmatan = $('#edit-fpk2-jumlah-tahun-perkhidmatan').val();

          var total = +Math.round (gaji) * (bulan) / (bil_hari_kerja_sebenar) * (bil_hari) * (jumlah_tahun_perkhidmatan);
            $('#edit-jumlah-rm-fpk2').val(total.toFixed(2));
            //alert (bulan);

        });
      },

      w3cFunction : function() {
        // w3c Color
        var w3cColor = $('.header-w3c-wrapper .ikon-jkt-w3c-color'),
            w3cFont = $('.header-w3c-wrapper .ikon-jkt-w3c-font');

        w3cFont.click(function() {
          var font = ($(this).prop('class')).replace(/ikon-jkt-w3c-font|ikon-w3c|-| /g,''); 
          switch (font) {
            case 'small': {
              w3cLoading(w3cFont,'font',-1);
              break;
            }
            case 'normal': {
              w3cLoading(w3cFont,'reset-font');
              break;
            }
            case 'big': {
              w3cLoading(w3cFont,'font',+1);
              break;
            }
          }
        });

        w3cColor.click(function() {
          var color = ($(this).prop('class')).replace(/ikon-jkt-w3c-color|ikon-w3c|-| /g,''); 
          switch (color) {
            case 'first': {
              w3cLoading(w3cColor,'color','#00099C','#D1CBA3');       
              break;
            }
            case 'second': {
              w3cLoading(w3cColor,'color','#FFFE00','#000000');       
              break;
            }
            case 'third': {
              w3cLoading(w3cColor,'color','#00099C','#5FCCFF');       
              break;
            }
            case 'reset': {
              w3cLoading(w3cColor,'reset-color');       
              break;
            }
          }
         
        });
      }

    }

    jtksm1.headerDate('#clock-date');
    jtksm1.search();
    jtksm1.pageTitle();
    //jtksm1.contentNavigationBottom();
    jtksm1.kalkulatorTidakCukupSebulan();
    jtksm1.kalkulatorGajiGantiNotis();
    jtksm1.kalkulatorGajiGantiNotis2();
    jtksm1.kalkulatorGajiGantiNotis3();
    jtksm1.kalkulatorFaedahPenamatanKerja();
    //jtksm1.kalkulatorFaedahPenamatanKerja2();
    jtksm1.w3cFunction();

    /* UPDATE DATE ON TOP HEADER */
    function updateDate() {
      var dayArrayBM = ['Ahad','Isnin','Selasa','Rabu','Khamis','Jumaat','Sabtu'];
      var dayArrayBI = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

      var monthArrayBM = ['Januari','Februari','Mac','April','Mei','Jun','Julai','Ogos','September','Oktober','November','Disember'];
      var monthArrayBI = ['January','February','March','April','May','June','July','August','September','October','November','December'];

      //var month = new Array();
          //month[0] = "Januari";
          //month[1] = "Febuari";
          //month[2] = "Mac";
          //month[3] = "April";
          //month[4] = "Mei";
          //month[5] = "Jun";
          //month[6] = "Julai";
          //month[7] = "Ogos";
          //month[8] = "September";
          //month[9] = "Oktober";
          //month[10] = "November";
          //month[11] = "Disember";

      //var lang = $('html').hasClass('en');
      var lang = $('body').hasClass('lang_en');

      var d = new Date();
      var day = (lang) ? dayArrayBI[d.getDay()] : dayArrayBM[d.getDay()];
      var month = (lang) ? monthArrayBI[d.getMonth()] : monthArrayBM[d.getMonth()];

      var date = d.getDate(),
          //month = month[d.getMonth()],
          year = d.getFullYear(),
          hours = ((d.getHours() + 11) % 12 + 1),
          minutes = d.getMinutes(),
          minutes = (minutes < 10) ? '0'+minutes:minutes;               

      var am = (d.getHours() >= 12) ? 'PM':'AM'; 

      return "<ul class=clock><li><span class=time-3>"+day+', '+date+' '+month+' '+year+'</span></li><li><span class=time>'+hours+':'+minutes+'</span> <span class=time-2>'+am+"</li></ul>";
      //return "<ul class=clock><li><span class=time-3>"+date+' '+month+' '+year+'</span></li><li><span class=time>'+hours+':'+minutes+'</span> <span class=time-2>'+am+"</li></ul>";
      //  return "<ul class=clock><li><span class=time-3>"+date+' '+month+' '+year+'</span></li><li><span class=time>'+hours+':'+minutes+'</span> <span class=time-2>'+am+"</li></ul>";
      
    }

    // W3C Function, COLOR & TEXT SIZE
    function w3cLoading(con,w3c,t,bg) {
      var place = $('<div id="w3c-loading">Loading...</div>'),
          posLeft = con.offset().left,
          posTop = con.offset().top+5;

      place.css({
        'left' : posLeft,
        'top' : posTop
      }).appendTo('body').fadeIn(function() {
        switch (w3c) {
          case 'color' : {
            setColor(t,bg);   
            break;
          }
          case 'font' : {
            w3cText(t);
            break;
          }
          case 'reset-color' : {
            setColor('reset');    
            break;
          }
          case 'reset-font' : {
            w3cText('reset');   
            break;
          }
        }
        $('#w3c-loading').remove();
      });
    }

    function setColor(color,bg) {
      var storeListOfElements = ["P", "LI", "A", "H1", "H2", "H3", "H4", "H5", "H6", "SPAN", "TD", "TH", "DT", "DD", "DL"];
      $("*").each(function(i, j) {
          if (($(this).css("color") != undefined) && (storeListOfElements.indexOf($(this).prop("tagName")) != -1)) {
            if (color == 'reset') {
              $(this).css({
                "color" : "",
                "background-color" : ""
              });
            }
            else {
              $(this).css({
                "color" : color,
                "background-color" : bg
              });     
            }
          }
      });
    }

    function w3cText(x) {
      var listOfElements = ["P", "LI", "A", "H1", "H2", "H3", "H4", "H5", "H6", "SPAN", "TD", "TH", "DT", "DD", "DL"];
      $("*").each(function(i, j) {
        if (($(this).css("font-size") != undefined) && (listOfElements.indexOf($(this).prop("tagName")) != -1)) {
          if (x == 'reset') {
            $(this).css("font-size", "");
          }
          else {
            var getSize = $(this).css("font-size");
            var currentSize = getSize.replace("px", "");
            if (currentSize >= 9 && currentSize <= 17) {
                $(this).css("font-size", parseInt(currentSize) + x + "px");
            }
          }
        }
      });
    }

  });

})(jQuery);
}

