(function($) {
  "use strict";
  $(function() {
    
    var jtksm3 = {
      
      kalkulatorot: function() {
        $('#btn-calculator-ot').on('click', function() {

          var gaji_sebulan = $('#edit-gaji-sebulan').val();
          var bil_hari_kerja_sebulan = 26;
          var bil_jam_kerja_sehari = $('#edit-jumlah-jam-bekerja-dalam-sehari').val();
          var bil_jam_ot_rateone = $('#edit-untuk-ot-rate-1-5').val(); 
          var bil_jam_ot_ratetwo = $('#edit-untuk-ot-rate-2-0').val();
          var bil_jam_ot_ratethree = $('#edit-untuk-ot-rate-3-0').val();
          // var piece_rate_ratetwo = $('#edit-ikut-kerja-2-0').val();
          // var piece_rate_ratethree = $('#edit-ikut-kerja-3-0').val();

          var total1 = gaji_sebulan / bil_hari_kerja_sebulan / bil_jam_kerja_sehari * 1.5 * bil_jam_ot_rateone;
            $('#edit-jumlah-rate-1-5-').val(total1.toFixed(2));
            //alert (total);
          var total2 = gaji_sebulan / bil_hari_kerja_sebulan / bil_jam_kerja_sehari * 2.0 * bil_jam_ot_ratetwo;
            $('#edit-jumlah-rate-2-0-').val(total2.toFixed(2));
          var total3 = gaji_sebulan / bil_hari_kerja_sebulan / bil_jam_kerja_sehari * 3.0 * bil_jam_ot_ratethree;
            $('#edit-jumlah-rate-3-0-').val(total3.toFixed(2));
          var hrp = gaji_sebulan / bil_hari_kerja_sebulan / bil_jam_kerja_sehari;
            $('#edit-kadar-upah-sejam-hourly-rate-of-pay-orp').val(hrp.toFixed(2));
          var ratebiasa = bil_jam_ot_rateone;
            $('#edit-bilangan-jam-layak-untuk-kadar-1-5-bayaran-').val(ratebiasa);
          var raterehat = bil_jam_ot_ratetwo;
            $('#edit-bilangan-jam-layak-untuk-kadar-2-0-bayaran-').val(raterehat);
          var rateam = bil_jam_ot_ratethree;
            $('#edit-bilangan-jam-layak-untuk-kadar-3-0-bayaran-').val(rateam);

          var total_ot = total1 + total2 + total3;
            $('#edit-bayaran-bekerja-lebih-masa').val(total_ot.toFixed(2));
        });

       $('#btn-reset').on('click', function() {
          $(':input','#webform-submission-kalkulator-bayaran-bekerja-lebih-node-406-add-form')
            .val('')
        });
      }

    }

    jtksm3.kalkulatorot();



  });

})(jQuery);
}

