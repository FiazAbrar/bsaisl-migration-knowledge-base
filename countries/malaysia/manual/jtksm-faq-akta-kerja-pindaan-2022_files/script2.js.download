(function($) {
  "use strict";
  $(function() {
    
    var jtksm2 = {
      tagCanvas: function() {
        $('#myCanvas').tagcanvas({
		      textColour: '#fff',
          outlineColour: '#fff',
          reverse: true,
          depth: 0.8,
          maxSpeed: 0.05,
          maxBrightness: 1.0,
          textFont: 'Roboto, sans-serif',
          weight: true,
          textHeight: 11,
          //hideTags: true,
          /*weightMode: 'size',
          weightSize: 1.0*/
          weightGradient: {
           0.5:    '#fff',
           0.7: '#fff',
           0.8: '#fff',
           1:    '#fff'
          },
          weightMode: 'both'
		    }, 'tags')
      },
      footerPart: function() {
        var totalText = $('#block-visitors li.list-group-item').text().split('Total Visitors: ');
        $('#block-visitors li.list-group-item').html(totalText[1]);
      },
      otherFunc: function() {
         if($('#block-jtksm-content .node__content >div >div').hasClass('full-width')) {
          $('main#content').addClass('full');
        }

        if($('#block-jtksm-content .node__content >div >div').hasClass('bg-pattern')) {
          $('main#content').addClass('no-space');
        }

        if($('main#content').next().hasClass('sidebar_first')) {
          $('#main').removeClass('container-fluid').addClass('container');
        }

        $('#pills-akta .views-field-body').mCustomScrollbar({
          theme:"dark"
        });

        $('#pills-borang-tab').on('click', function() {
          var spanPartDefault = $('#pills-tabContent #pills-borang').find(('.borang-title > span'));
          spanPartDefault.each(function() {
            if($(this).is(':empty')) {
              $(this).remove();
            }
          });
        });

        var accNormal = $('#pills-akta .normal-accordion .views-field-title, #pills-borang .normal-accordion .views-field-title');
        accNormal.each(function() {
          $(this).on('click', function() {
            var spanPart = $(this).next().find(('.borang-title > span'));
            spanPart.each(function() {
              if($(this).is(':empty')) {
                $(this).remove();
              }
            });

            if($(this).next().find('.views-field-body').height() > 399) {
              $(this).next().find('.views-field-body').height(400); 
              $(this).next().find('.views-field-body').mCustomScrollbar({
                theme:"dark"
              });
            }
          });
        });

        if ($(window).width() < 768) {
          var thTable = $('.tender-list table thead th');
          var trTable = $('.tender-list table tbody tr');

          thTable.each(function() {
            var thPos = $(this).index();
            var thText = $(this).html();
            trTable.each(function() {
              $(this).find('td').eq(thPos).prepend('<div class="header-table">'+thText+'</div');
            });
          });


          var thTableResult = $('.result-list table thead th');
          var trTableResult = $('.result-list table tbody tr');

          thTableResult.each(function() {
            var thPosResult = $(this).index();
            var thTextResult = $(this).html();
            trTableResult.each(function() {
              $(this).find('td').eq(thPosResult).prepend('<div class="header-table">'+thTextResult+'</div');
            });
          });

          var thTableGray = $('.gray-table table thead th, .APS-table thead th');
          var trTableGray = $('.gray-table table tbody tr, .APS-table tbody tr');

          thTableGray.each(function() {
            var thPosGray = $(this).index();
            var thTextGray = $(this).html();
            trTableGray.each(function() {
              $(this).find('td').eq(thPosGray).prepend('<div class="header-table">'+thTextGray+'</div');
            });
          });
        }

        if ($('body').hasClass('path-sitemap')) {
          var listSite = $('.sitemap-item ul');
          listSite.each(function() {
            var listHtml = $(this).find('li a').html();
            var listSpanHtml = $(this).find('li span').html();
            if (listHtml == 'Tender' || listHtml == 'Sebut Harga' || listHtml == 'Tenders' || listHtml == 'Quotations') {
              $(this).find('li').css({
                'display' : 'none'
              });
            }
          });
        }

        if ($('nav').hasClass('kalkulator-list')) {
          var navList = $('nav.kalkulator-list ul li');
          navList.each(function() {
            var navHtml = $(this).find('a').html().split('(');
            var navValue = navHtml[1];

            if(navValue !== undefined) {
              $(this).find('a').html(navHtml[0] + '<p class="little-title">('+navHtml[1]+'</p>')
            } 
          });
        }

      },
      contentNavigationBottom: function() {
        var menub = $('.mainnavigation-bottom');
        var menuListb = [];
        var getMenub = menub.find('.navbar-nav a');
        var outputMenub = $('<div />', {
          id: 'content-navigation-menu-b'
        });

        $.each(getMenub, function() {
          //Get all anchor tag
          menuListb.push($(this));
        });
        //Construct our navigation output
        $.each(menuListb, function() {
          $(this).appendTo(outputMenub);
        });
        outputMenub.insertAfter(menub);
        //Loop our newly add anchor tags and show next/prev page
        $.each($('#content-navigation-menu-b a'), function() {
          //$( "#content-navigation-menu .dropdown-toggle" ).remove();
          $("#content-navigation-menu-b").find(".dropdown-toggle").removeAttr('data-toggle');


          if ($(this).hasClass('is-active')) {

            if ($(this).next().attr('href') != $(this).attr('href')) {

              if (!$("#content-navigation-menu-b a.menu-next").length) {
                $(this).next().addClass('menu-visible menu-next')
              }
            }

          }

        });
        if ($("#content-navigation-menu-b a.menu-next").length) {
          $('body').addClass("hav-nextpage");
        } else {
          $('body').addClass("havno-nextpage");
        }
      },
      paginationContent: function() {
        var totalDiv = 0;
        var divPage = $('.custom-pagination .page-mimi');
        divPage.each(function() {
          if($(this).length > 0) {
            totalDiv +=1;
          }
        });

        $('#luckmoshy').luckmoshyPagination({
        totalPages: totalDiv,
        startPage: 1,
        visiblePages: 4,
        initiateStartPageClick: true,
        hideOnlyOnePage: false,
        href: false,
        first: 'f',
        prev: 'f',
        next: 'f',
        last: 'f',

        // carousel-style pagination
        loop: false,
        onPageClick: null,

        // callback function
        onPageClick: function (event, page) {
           $('.page-active').removeClass('page-active');
          $('#container-pagnation'+page).addClass('page-active');
        },

        // pagination Classes
        paginationClass: 'pagination',
        nextClass: 'next',
        prevClass: 'prev',
        lastClass: 'last',
        firstClass: 'first',
        pageClass: 'page-item ',
        activeClass: 'active',
        disabledClass: 'disabled'
        });
      }
    }

    jtksm2.tagCanvas();
    jtksm2.footerPart();
    jtksm2.otherFunc();
    jtksm2.contentNavigationBottom();
    jtksm2.paginationContent();
  });

})(jQuery);

(function ($, Drupal, drupalSettings) {
  Drupal.behaviors.namaTheme = {
    attach: function (context, settings) {
      var lokasiFrame = $('.view-cawangan .views-row');
      lokasiFrame.each(function() {
        $(this).find('.views-field-nothing-1 .field-content .modal .modal-body').html($(this).find('.views-field-field-peta .field-content').html());
      });

      var agensiFrame = $('.list-mapping .views-row');
      agensiFrame.each(function() {
        $(this).find('.views-field-nothing-2 .field-content .modal .modal-body').html($(this).find('.views-field-field-peta .field-content').html());
      });

      if ($(window).width() < 768) {
        var thTable = $('.tender-list table thead th');
        var trTable = $('.tender-list table tbody tr');

        thTable.each(function() {
          var thPos = $(this).index();
          var thText = $(this).html();
          trTable.each(function() {
            $(this).find('td').eq(thPos).prepend('<div class="header-table">'+thText+'</div');
          });
        });

        var thTableResult = $('.result-list table thead th');
        var trTableResult = $('.result-list table tbody tr');

        thTableResult.each(function() {
          var thPosResult = $(this).index();
          var thTextResult = $(this).html();
          trTableResult.each(function() {
            $(this).find('td').eq(thPosResult).prepend('<div class="header-table">'+thTextResult+'</div');
          });
        });

        var thTableGray = $('.gray-table table thead th');
        var trTableGray = $('.gray-table table tbody tr');

        thTableGray.each(function() {
          var thPosGray = $(this).index();
          var thTextGray = $(this).html();
          trTableGray.each(function() {
            $(this).find('td').eq(thPosGray).prepend('<div class="header-table">'+thTextGray+'</div');
          });
        });
      }
    }
  };
})(jQuery, Drupal, drupalSettings);
}

