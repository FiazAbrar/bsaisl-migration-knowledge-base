new Plyr("#player", {
  hideControls: true,
  controls: ["play-large", "play", "progress"],
  fullscreen: {
    enabled: false,
  },
})

let videos = document.querySelectorAll(".player-two")
videos.forEach((ele) => {
  new Plyr(ele, {
    hideControls: true,
    controls: ["play-large"],
    fullscreen: {
      enabled: false,
    },
  })
})
