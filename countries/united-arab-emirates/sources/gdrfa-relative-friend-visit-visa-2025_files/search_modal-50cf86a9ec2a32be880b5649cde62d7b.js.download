  /* Search in services script */
 
  document.addEventListener('DOMContentLoaded', function () {
  const searchModal = document.getElementById('modalSearch');

  if (!searchModal) {
    return;
  }

  const searchInput = searchModal.querySelector('input[name="search_api_fulltext"]');
  const clearButton = searchModal.querySelector('.gdrfa-search-clear-icon');

  if (!searchInput || !clearButton) {
    return;
  }

  const updateClearButton = function () {
    clearButton.hidden = searchInput.value.length === 0;
  };

  searchInput.addEventListener('input', updateClearButton);
  clearButton.addEventListener('click', function () {
    searchInput.value = '';
    searchInput.dispatchEvent(new Event('input', { bubbles: true }));
    searchInput.dispatchEvent(new Event('change', { bubbles: true }));
    searchInput.focus();
  });

  updateClearButton();
});

  