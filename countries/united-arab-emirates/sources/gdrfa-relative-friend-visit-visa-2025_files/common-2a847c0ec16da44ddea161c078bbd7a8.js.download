var dnrdLightSrc = "/themes/gdrfad/images/gdifa-logo.svg";
var dnrdDarkSrc = "/themes/gdrfad/images/gdifa-logo-white.svg";

var dubaiGovLightSrc = "/themes/gdrfad/assets/phase3/img/dubai-gov-logo.svg";
var dubaiGovDarkSrc = "/themes/gdrfad/assets/phase3/img/dubai-gov-logo-white.svg";


var url = document.location.href;

var windowObjectReference = null; // global variable
var PreviousUrl; /* global variable that will store the
                    url currently in the secondary window */
                    
                    
function trackFileDownload(fileUrl, $link) {
  if (!fileUrl) {
    return;
  }

  var downloadExtensions = [
    "pdf", "doc", "docx", "xls", "xlsx", "csv", "ppt", "pptx",
    "txt", "rtf", "zip", "rar", "7z", "tar", "gz", "xml", "json",
    "jpg", "jpeg", "png", "gif", "svg", "mp3", "wav", "mp4", "avi", "mov"
  ];

  try {
    var parsedUrl = new URL(fileUrl, window.location.href);
    var fileName = decodeURIComponent(parsedUrl.pathname.split("/").pop() || "");
    var extension = fileName.indexOf(".") !== -1
      ? fileName.split(".").pop().toLowerCase()
      : "";

    if (downloadExtensions.indexOf(extension) === -1) {
      return;
    }

    var analyticsData = {
      file_name: fileName,
      file_extension: extension,
      link_url: parsedUrl.href,
      link_text: $.trim($link.text()) || $link.attr("aria-label") || "",
      link_id: $link.attr("id") || "",
      link_classes: $link.attr("class") || "",
      link_domain: parsedUrl.hostname,
      page_language: document.documentElement.lang ||
        (typeof currentLanguage !== "undefined" ? currentLanguage : ""),
      download_category: $link.attr("data-download-category") || "general",
      link_location: window.location.href,
      service_id: $link.attr("data-service-id") || ""
    };

    if (typeof window.gtag !== "function") {
      return;
    }

    window.gtag("event", "file_download", analyticsData);
  } catch (error) {
    // Ignore invalid URLs and continue opening the file.
  }
}



function openRequestedSinglePopup(url) {
  if(windowObjectReference == null || windowObjectReference.closed) {
    windowObjectReference = window.open(url, "SingleSecondaryWindowName");
  } else if(PreviousUrl != url) {
    windowObjectReference = window.open(url, "SingleSecondaryWindowName");
    /* if the resource to load is different,
       then we load it in the already opened secondary window and then
       we bring such window back on top/in front of its parent window. */
    windowObjectReference.focus();
  } else {
    windowObjectReference.focus();
  };
  PreviousUrl = url;
  /* explanation: we store the current url in order to compare url
     in the event of another call of this function. */
}



function numberWithCommas(x) {
    return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}



