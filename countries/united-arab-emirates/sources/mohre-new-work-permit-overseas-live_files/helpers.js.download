    // Cookies
    window.getThemeCookie = function () {
        var c = getCookie('icms-theme');
        return c.replace(/[^a-z0-9]/gi, '');
    }
    window.getCookie = function (cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');

        for (var i = 0; i < ca.length; i++) {
            var c = ca[i].trim();  // .trim() handles all whitespace, simpler than while loop
            if (c.indexOf(name) === 0) {  // Use === for strict comparison
                return c.substring(name.length);
            }
        }
        return "";
    }
    window.setCookie = function (cname, cvalue, exdays) {
        // Validate input
        if (typeof cvalue !== 'string') {
            cvalue = String(cvalue);
        }

        // Use whitelist validation or encoding instead of blacklist
        // Encode the value properly - this prevents injection
        var encodedValue = encodeURIComponent(cvalue);

        var d = new Date();
        var days = exdays || 365;
        d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
        var expires = "expires=" + d.toUTCString();

        var path = "/"; // Use root path, or get from configuration safely
        var cookieString = cname + "=" + encodedValue + ";" + expires + ";path=" + path;

        // Only add secure flag if connection is HTTPS
        if (location.protocol === 'https:') {
            cookieString += "; secure";
        }

        cookieString += "; SameSite=Strict";
        document.cookie = cookieString;
    }

    window.deleteCookie = function (cname) {
        document.cookie = cname + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=" + FI.ApplicationPath + ";";
    }
    window.getParameterByName = function (name, url = window.location.href) {
        name = name.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    }


    //#endregion helpers


    //#region Theme
    var _theme = getThemeCookie();
    if (!_theme) {
        if ($('[data-icms-event-click="theme"][data-icms-isdefault]').attr('data-icms-theme')) {
            setCookie('icms-theme', $('[data-icms-event-click="theme"][data-icms-isdefault]').attr('data-icms-theme'));
        }
    }
    $('[data-icms-event-click][data-icms-theme]').removeClass('checked');
    $('[data-icms-event-click="theme"][data-icms-theme="' + _theme + '"]').addClass('checked');
    $('html').addClass(_theme);

    //#endregion

});