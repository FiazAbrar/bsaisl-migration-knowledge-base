 (function flydubai_j11389_11070v1() {
    const selectors = {
        stickyBottom: 'section.journeyCart'
    };
    if (document.querySelector(selectors.stickyBottom) && !document.querySelectorAll('.flydubai_j11389_11070v1').length) {
        checkTarget();
        var targetNode = document.querySelector('fz-root');
        var config = { attributes: false, childList: true, subtree: true, characterData: true };
        var observer = new MutationObserver(checkTarget);
        if (targetNode) observer.observe(targetNode, config);
        addListners();
        document.body.classList.add('flydubai_j11389_11070v1');
    } else if (!document.querySelectorAll('.flydubai_j11389_11070v1').length) {
        requestAnimationFrame(flydubai_j11389_11070v1);
    }
    function checkTarget() {
        let journeyInfo = document.querySelector(selectors.stickyBottom);
        let slug = location.pathname;
        if (journeyInfo && (slug.includes('/en/optional/') || slug.includes('/en/results/'))) {
            addShortSummary(journeyInfo);
        } else {
            removeChanges();
        }
    }
    function removeChanges(){
        let newElems = document.querySelectorAll('.v_trimmedAccordion');
        if (newElems.length) {
            newElems.forEach(elem => elem.remove());
        }
    }
    function addShortSummary(target) {
        if (target) {
            let priceEl = target.querySelector('fz-currency-amount.cart_amount');
            if (priceEl) {
                let priceTxt = priceEl.textContent.trim();
                if (!target.querySelector('.v_trimmedAccordion')) {
                    let sHtm = `
            <div class="v_trimmedAccordion" data-price="${priceTxt}">
                <h3>View trip summary</h3>
                <p>
                    <span class="v_finalCartAmt">${priceTxt}</span> 
                    <svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" class="v_expandAccordion">
                        <path d="M5.75 14.375L11.5 8.625L17.25 14.375" stroke="white" stroke-width="0.960431" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </p>
            </div>`;
                    target.insertAdjacentHTML('afterbegin', sHtm);
                } else if (target.querySelector('.v_trimmedAccordion')) {
                    let addedPrice = target.querySelector('.v_trimmedAccordion').dataset.price;
                    if (addedPrice != priceTxt) {
                        target.querySelector('.v_trimmedAccordion').remove();
                        addShortSummary(target);
                    }
                }
            }
        }
    }
    function addListners(){
        document.addEventListener('click', function(e) {
            let trgt = e.target;
            let expander = trgt.closest('.v_trimmedAccordion') ? trgt.closest('.v_trimmedAccordion') : trgt.classList.contains('v_trimmedAccordion') ? trgt : null;
            if (expander) {
                let originalAccordionArrow = expander.closest('.journeyCart')?.querySelector('mat-expansion-panel-header');
                if (originalAccordionArrow) {
                    originalAccordionArrow.click();
                }
            }
        });
    }
})();
 
