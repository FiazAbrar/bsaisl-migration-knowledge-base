ion.split(",")[0],flight_destination_country_name:dataObj.Destination.split(",")[2],flight_departure_date:getFlightOutDate(dataObj),flight_return_date:getFlightReturnDate(dataObj),journey_type:getJourneyType(dataObj),page_name:window.location.href});}$.ajax({type:"POST",url:$form.attr("action"),data:$form.serialize(),success:function(data,textStatus,jqXHR){var $timeTableContainer=$(timeTableContainer);$timeTableContainer.html("");$timeTableContainer.append(data);},error:function(jqXHR,textStatus,errorThrown){},complete:function(qXHR,textStatus){$button.prop("disabled",false);FD.atom.loader.hide();}});}event.preventDefault();}function IfOneWayDisableReturnDate(){if($(oneWayCheckBox,$form).is(":checked")){$(returnDate,$form).addClass("disabled").attr("disabled","disabled").val("").parent().attr("data-day","");returnEnabled=false;}}function removeDuplicateObjects(arr,property){var uniqueObjects=[];for(var i=0;i<arr.length;i++){var currentObject=arr[i];var isDuplicate=false;for(var j=0;j<uniqueObjects.length;j++){if(haveSameProperties(currentObject,uniqueObjects[j],property)){isDuplicate=true;}}if(!isDuplicate){uniqueObjects.push(currentObject);}}return uniqueObjects;}function haveSameProperties(obj1,obj2,property){if(obj1[property]===obj2[property]){return true;}return false;}function getJourneyType(dataObj){if(dataObj.IsOneWay=="false"){return"Round Trip";}else{return"One Way";}}function getFlightOutDate(dataObj){if(dataObj.FlyingOutOn){return formatDate(dataObj.FlyingOutOn);}else{return"NA";}}function getFlightReturnDate(dataObj){if(dataObj.FlyingBackOn){return formatDate(dataObj.FlyingBackOn);}else{return"NA";}}function formatDate(date){var newDate=new Date(date);var year=newDate.getFullYear();var month=(newDate.getMonth()+1).toString();month=month.length===1?"0"+month:month;var day=newDate.getDate().toString();day=day.length===1?"0"+day:day;return year+"-"+month+"-"+day;}};pageScripts.IfDestinationPresentSetDistinationAirport=function(airportContainer,airportCode,a