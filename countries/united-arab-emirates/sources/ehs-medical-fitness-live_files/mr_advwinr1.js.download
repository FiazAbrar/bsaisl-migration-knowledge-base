.mr-cont-tooltip-window.mr-modern-ui {
  border-radius: 16px !important;
  overflow: hidden !important;
  box-shadow: 0 14px 42px rgba(0, 0, 0, 0.28) !important;
  border: none !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
  width: auto !important;
}
.mr-cont-tooltip-window.mr-modern-ui.mr-docked {
  box-shadow: none !important;
}
.mr-cont-tooltip-window.mr-modern-ui iframe {
  display: block;
  background: transparent !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar {
  height: 44px !important;
  padding: 0 10px !important;
  background-color: var(--mr-fore-color) !important;
  background-size: 22px !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  cursor: move !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: flex-start !important;
  box-sizing: border-box !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 34px !important;
  height: 34px !important;
  margin: 0 2px !important;
  border-radius: 8px !important;
  text-decoration: none !important;
  padding: 0 !important;
  cursor: pointer !important;
  border: 2px solid transparent !important;
  background: transparent !important;
  color: inherit !important;
  font: inherit !important;
  transition: background-color 0.18s ease, transform 0.1s ease !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a#mrCloseBtn,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button#mrCloseBtn {
  margin-inline-start: auto !important;
  
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a:hover,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button:hover {
  background-color: rgba(0, 0, 0, 0.45) !important;
  outline: 2px solid var(--mr-back-color) !important;
  outline-offset: -2px !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a:active,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button:active {
  transform: scale(0.94) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a:focus-visible,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button:focus-visible {
  outline: 3px solid var(--mr-back-color) !important;
  outline-offset: 3px !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .iconBtn,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a img,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button img {
  height: 22px !important;
  width: 22px !important;
  padding: 0 !important;
  margin: 0 !important;
  filter: brightness(0) saturate(100%) invert(100%) !important;
  opacity: 1 !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .iconBtn.active,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a .iconBtn.active,
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button .iconBtn.active {
  background-color: rgba(0, 0, 0, 0) !important;
  border-radius: 8px !important;
}
.mr-cont-tooltip-window.mr-modern-ui a#mrSetBtn:has(.iconBtn.active) {
  background-color: rgba(0, 0, 0, 0.5) !important;
  outline: 1px solid rgba(255, 255, 255, 0.5);
}
.mr-cont-tooltip-window.mr-modern-ui #mr-setting-holder {
  position: relative !important;
  background-color: var(--mr-fore-color) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #mr-set-window-cont {
  background-color: var(--mr-fore-color) !important;
  color: var(--mr-back-color) !important;
  padding: 18px 16px 56px 16px !important;
  border: none !important;
  border-radius: 0 0 12px 12px !important;
  animation: mrModernSlideIn 0.22s ease-out !important;
}
.mr-cont-tooltip-window.mr-modern-ui .Mr-set-content {
  background-color: var(--mr-fore-color) !important;
  color: var(--mr-back-color) !important;
  border: none !important;
}
@keyframes mrModernSlideIn {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}
.mr-cont-tooltip-window.mr-modern-ui .mr-men-range-holder {
  align-items: center !important;
  padding: 6px 0 !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-set-label {
  flex: 0 0 38px !important;
  margin-left: 0 !important;
  margin-inline-end: 12px !important;
  text-align: center !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-set-label .mr-sl-icon {
  width: 24px !important;
  height: 24px !important;
  float: none !important;
  margin: 0 !important;
  filter: brightness(0) saturate(100%) invert(100%) !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-men-stepper-holder {
  display: flex !important;
  flex-flow: row !important;
  align-items: center !important;
  padding: 10px 0 !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-set-stepper-control {
  flex: 1 1 auto !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px !important;
  background-color: rgba(0, 0, 0, 0.5) !important;
  border-radius: 10px !important;
  padding: 4px !important;
  outline: 1px solid rgba(255, 255, 255, 0.5);
}
.mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 30px !important;
  height: 30px !important;
  border-radius: 8px !important;
  background-color: var(--mr-back-color) !important;
  color: var(--mr-fore-color) !important;
  font-size: 21px !important;
  font-weight: 600 !important;
  line-height: 1 !important;
  text-decoration: none !important;
  user-select: none !important;
  border: 1px solid var(--mr-back-color) !important;
  transition: background-color 0.15s ease, transform 0.1s ease !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn:hover {
  background-color: rgba(0, 0, 0, 0.45) !important;
  color: var(--mr-back-color) !important;
  box-shadow: inset 0 0 0 1px var(--mr-back-color) !important;
  outline: 2px solid var(--mr-back-color) !important;
  outline-offset: -2px !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn:active {
  transform: scale(0.94) !important;
}
.mr-stepper-btn:focus-visible {
  outline: 3px solid var(--mr-fore-color);
  outline-offset: -2px;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn:focus-visible {
  outline: 3px solid #ffffff !important;
  outline-offset: 2px !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-stepper-value {
  flex: 1 1 auto !important;
  text-align: center !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  color: var(--mr-back-color) !important;
  min-width: 48px !important;
  user-select: none !important;
}
.mr-cont-tooltip-window.mr-modern-ui #mr-set-toolbox {
  position: absolute !important;
  top: auto !important;
  right: 10px !important;
  bottom: 12px !important;
  display: flex !important;
  flex-direction: row !important;
  gap: 8px !important;
  padding: 2px !important;
  z-index: 2 !important;
}
.mr-cont-tooltip-window[dir="rtl"].mr-modern-ui #mr-set-toolbox,
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #mr-set-toolbox,
.mr-cont-tooltip-window.mr-modern-ui *[dir="rtl"] #mr-set-toolbox {
  right: auto !important;
  left: 10px !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 32px !important;
  height: 32px !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background-color: rgba(0, 0, 0, 0.5) !important;
  outline: 1px solid rgba(255, 255, 255, 0.5) !important;
  transition: background-color 0.15s ease, transform 0.1s ease, outline-color 0.15s ease !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element:hover {
  background-color: rgba(0, 0, 0, 0.65) !important;
  border-color: var(--mr-back-color) !important;
  box-shadow: 0 0 0 1px var(--mr-back-color) !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element:active {
  transform: scale(0.94) !important;
}
.mr-setting-side-element:focus-visible {
  outline: 3px solid var(--mr-fore-color);
  outline-offset: -2px;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element:focus-visible {
  outline: 3px solid var(--mr-back-color) !important;
  outline-offset: -2px !important;
}

.mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element img {
  width: 18px !important;
  height: 18px !important;
  margin: 0 !important;
  float: none !important;
}
.mr-cont-tooltip-window.mr-modern-ui #BtnBgColor[style*="display: none"] {
  display: none !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrAdvFtHolder {
  height: auto !important;
  min-height: 44px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 6px 10px !important;
  margin: 0 !important;
  background-color: var(--mr-fore-color) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-radius: 0 0 12px 12px !important;
  box-sizing: border-box !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn {
  display: inline-flex;
  align-items: center !important;
  justify-content: center !important;
  width: 34px !important;
  height: 34px !important;
  margin: 0 !important;
  font-size: 22px !important;
  border-radius: 8px !important;
  text-decoration: none !important;
  outline: none !important;
  transition: background-color 0.15s ease, transform 0.1s ease !important;
}
.mr-adv-feature-btn:focus-visible {
  outline: 3px solid var(--mr-fore-color);
  outline-offset: -2px;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn:focus-visible {
  outline: 3px solid var(--mr-back-color) !important;
  outline-offset: -2px !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn:hover {
  background-color: rgba(0, 0, 0, 0.45) !important;
  outline: 2px solid var(--mr-back-color) !important;
  outline-offset: -2px !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn:active {
  transform: scale(0.94) !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn.active {
  background-color: rgba(0, 0, 0, 0.6) !important;
  outline: 1px solid rgba(255, 255, 255, 0.5) !important;
}
.mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn .mrslbtn-icon {
  margin: 0 !important;
  color: var(--mr-back-color) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #mr-move-screen {
  background-color: transparent !important;
}
.mr-cont-tooltip-window.mr-modern-ui #mr-move-screen > div {
  border: none !important;
  background: transparent !important;
}
.mr-cont-tooltip-window.mr-modern-ui #mr-move-screen > div > div {
  border: 2px dashed rgba(255, 255, 255, 0.18) !important;
  border-radius: 10px !important;
  background: rgba(255, 255, 255, 0.04) !important;
}
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #mr-set-toolbox,
.mr-cont-tooltip-window.mr-modern-ui *[dir="rtl"] #mr-set-toolbox {
  right: auto !important;
  left: 10px !important;
}
.mr-cont-tooltip-window[dir="rtl"] #MrAdvFtHolder .mricon-sl-to-start,
.mr-cont-tooltip-window[dir="rtl"] #MrAdvFtHolder .mricon-sl-to-end {
  display: inline-block !important;
  transform: scaleX(-1) !important;
}
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #MrAdvFtHolder #MrSlPNextButton {
  order: 1 !important;
}
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #MrAdvFtHolder #mrSlPausePlayBtn {
  order: 2 !important;
}
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #MrAdvFtHolder #MrSlPPrevButton {
  order: 3 !important;
}
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #MrAdvFtHolder #MrSlPPrevButton .mrslbtn-icon,
.mr-cont-tooltip-window.mr-modern-ui[dir="rtl"] #MrAdvFtHolder #MrSlPNextButton .mrslbtn-icon {
  display: inline-block !important;
  transform: scaleX(1) !important;
}
@media (prefers-reduced-motion: reduce) {
  .mr-cont-tooltip-window.mr-modern-ui #mr-set-window-cont {
    animation: none !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .iconBtn,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a img,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button img,
  .mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn,
  .mr-cont-tooltip-window.mr-modern-ui .mr-setting-side-element,
  .mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn {
    transition: none !important;
    transform: none !important;
  }
}
@media (max-width: 480px) {
  .mr-cont-tooltip-window.mr-modern-ui {
    border-radius: 12px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar {
    height: 40px !important;
    padding: 0 8px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button {
    width: 30px !important;
    height: 30px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .iconBtn,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > a img,
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar > button img {
    height: 18px !important;
    width: 18px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui .mr-set-label {
    flex: 0 0 32px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui .mr-set-label .mr-sl-icon {
    width: 20px !important;
    height: 20px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui .mr-stepper-btn {
    width: 28px !important;
    height: 28px !important;
    font-size: 18px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui .mr-stepper-value {
    font-size: 14px !important;
    min-width: 40px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #mr-set-window-cont {
    padding: 14px 12px 52px 12px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrAdvFtHolder {
    min-height: 40px !important;
    padding: 4px 8px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui .mr-adv-feature-btn {
    width: 30px !important;
    height: 30px !important;
    font-size: 18px !important;
    display: inline-flex;
    margin: 0 !important;
  }
}
