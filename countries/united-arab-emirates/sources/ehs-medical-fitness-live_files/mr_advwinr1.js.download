.mr-cont-tooltip-window.mr-modern-ui.mr-minimized {
  height: auto !important;
}
.mr-cont-tooltip-window.mr-modern-ui.mr-minimized #mr-setting-holder,
.mr-cont-tooltip-window.mr-modern-ui.mr-minimized #mr-move-screen {
  display: none !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-buttons {
  display: inline-flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4px !important;
  width: 76px !important;
  padding: 2px !important;
  margin: 0 4px !important;
  border-radius: 10px !important;
  background-color: rgba(0, 0, 0, 0.5) !important;
  box-sizing: border-box !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 32px !important;
  height: 26px !important;
  border-radius: 6px !important;
  background-color: rgba(0, 0, 0, 0.35) !important;
  color: var(--mr-back-color) !important;
  font-size: 16px !important;
  text-decoration: none !important;
  transition: background-color 0.15s ease, transform 0.1s ease !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn:hover {
  background-color: rgba(0, 0, 0, 0.6) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn:active {
  transform: scale(0.94) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn.active {
  background-color: rgba(0, 0, 0, 0.7) !important;
}
.mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn:focus-visible {
  outline: 3px solid var(--mr-back-color) !important;
  outline-offset: 2px !important;
}
@media (max-width: 480px) {
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-buttons {
    width: 72px !important;
    padding: 2px !important;
  }
  .mr-cont-tooltip-window.mr-modern-ui #MrTitleBar .mr-dock-position-btn {
    width: 30px !important;
    height: 24px !important;
    font-size: 15px !important;
  }
*/
}
