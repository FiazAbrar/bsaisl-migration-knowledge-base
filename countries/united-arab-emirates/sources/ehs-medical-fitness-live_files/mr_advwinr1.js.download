.mr-cont-tooltip-window:not(.mr-modern-ui) .mr-stepper-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; min-height: 24px; border-radius: 4px; text-decoration: none; }
.mr-cont-tooltip-window:not(.mr-modern-ui) .mr-stepper-btn:hover { background-color: rgba(0, 0, 0, 0.45) !important; color: var(--mr-back-color) !important; box-shadow: inset 0 0 0 1px var(--mr-back-color) !important; outline: 2px solid var(--mr-back-color); outline-offset: -2px; }
.mr-cont-tooltip-window:not(.mr-modern-ui) .mr-stepper-btn:active { transform: scale(0.94) !important; }
