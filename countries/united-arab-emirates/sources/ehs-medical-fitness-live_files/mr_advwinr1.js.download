#mr-tut-window.MrFilp{left: var(--mr-tut-win-right) !important;    right: var(--mr-tut-win-left) !important;}
#mr-tut-window.mr-tut-rtl *:not(.mr-tut-timeline,.mr-tut-image-container){direction: rtl !important;text-align: right !important;}
#mr-tut-window:not(.mr-tut-rtl) *:not(.mr-tut-timeline,.mr-tut-image-container){direction: ltr !important;text-align: left !important; }
#mr-tut-window.mr-tut-rtl .mr-tut-image-container figcaption{text-align: right !important;}
#mr-tut-window:not(.mr-tut-rtl) .mr-tut-image-container figcaption{text-align: left !important;}
#mr-tut-window.mr-tut-rtl .mr-tut-timeline{text-align: left;}
#mr-tut-window *{ color:var(--mr-fore-color) !important; } #mr-tut-window h2{ font-weight: bolder !important; } #mr-tut-window h3{ font-weight: bold !important; }
.mr-tut-section {display: none;}.mr-tut-section.active{display: block;}
.mr-tut-step {background: var(--mr-back-color);padding-left: 10px;padding-right: 10px;margin-bottom: 20px;border-radius: 8px;box-shadow: 0 2px 5px var(--mr-back-color);}
.mr-tut-step .mr-tut-step {border: 1px solid var(--mr-fore-color);}
.mr-tut-step-title {text-align: center;font-size: 26px; margin-bottom: 16px;}
.mr-tut-step-text {font-size: 16px;margin-bottom: 15px;text-align: right;color: var(--mr-fore-color);}
h2.mr-tut-step-text {border-bottom: 1px solid var(--mr-fore-color);} h3.mr-tut-step-text {font-size: 20px;} .mr-tut-step-text strong {color: var(--mr-fore-color);}
.mr-tut-image-container {text-align: center;margin: 0 0 20px 0;}.mr-tut-image {border: 2px solid var(--mr-fore-color);border-radius: 8px;max-width: 100%;height: auto;}
.mr-tut-timeline {   position: sticky;bottom: var(--mr-tut-timeline-bottom); width: var(--mr-tut-timeline-width); height: var(--mr-tut-timeline-height);    text-align: right;`+(SiteLang?"margin-right":"margin-left")+`: var(--mr-tut-timeline-mr);    padding:  calc( var(--mr-circ-size) * 0.05 );}
.mr-tut-section-circle { width: var(--mr-circ-size);height: var(--mr-circ-size); display: var(--mr-tut-circle-disp); margin: 2px;  margin-top: 0px; border-radius: calc( var(--mr-circ-size) * 0.5 ); cursor: pointer; padding: 0; background: transparent; border: none; font-size: 0;}
.mr-tut-section-circle:focus-visible { outline: 2px solid var(--mr-fore-color); outline-offset: 2px; }
.mr-tut-section-circle:hover { outline: 2px solid currentColor; outline-offset: 2px; box-shadow: 0 0 0 2px var(--mr-back-color); }
.mr-tut-section-circle:active { transform: scale(0.94); }
.mr-tut-section-circle.active {    background-color:var(--mr-fore-color);    border:1px solid var(--mr-back-color);}
.mr-tut-section-circle:not(.active) {    background-color:var(--mr-back-color);    border:1px solid var(--mr-fore-color);}
#mr-tut-window-background { outline: none; }
#mr-tut-close-btn:hover { border: 2px solid #FFFFFF !important; border-radius: 4px !important; }
#mr-tut-close-btn:focus-visible { outline: 2px solid #FFFFFF !important; outline-offset: 2px !important; }
#mr-tut-close-btn:active { border: 2px solid #FFFFFF !important; border-radius: 4px !important; }
`+(n?`
#mr-tut-window.mr-tut-modern { border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.35); }
#mr-tut-window.mr-tut-modern .mr-tut-modern-section { padding: 8px; }
#mr-tut-window.mr-tut-modern .mr-tut-modern-title { font-size: 28px; margin-bottom: 20px; }
#mr-tut-window.mr-tut-modern .mr-tut-modern-step { background: rgba(128,128,128,0.12); border: 1px solid rgba(128,128,128,0.25); border-radius: 10px; padding: 14px; margin-bottom: 16px; box-shadow: none; }
#mr-tut-window.mr-tut-modern .mr-tut-modern-step-text { font-size: 20px; border-bottom: none; }
#mr-tut-window.mr-tut-modern .mr-tut-modern-substep-text { font-size: 16px; line-height: 1.6; }
