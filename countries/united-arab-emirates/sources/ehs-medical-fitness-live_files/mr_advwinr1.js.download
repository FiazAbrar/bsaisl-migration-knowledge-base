.mr-cont-tooltip-window:not(.mr-modern-ui) #MrTitleBar .iconBtn { display: inline-block; width: 28px !important; height: 28px !important; padding: 3px !important; box-sizing: border-box !important; border-radius: 4px !important; vertical-align: middle !important; }
.mr-cont-tooltip-window:not(.mr-modern-ui) #MrTitleBar > a:hover .iconBtn, .mr-cont-tooltip-window:not(.mr-modern-ui) #MrTitleBar > button:hover .iconBtn { background-color: rgba(0, 0, 0, 0.45) !important; border-radius: 4px !important; outline: 2px solid ${MrTextColor} !important; outline-offset: -2px !important; }
.mr-cont-tooltip-window:not(.mr-modern-ui) #MrTitleBar > a:active .iconBtn, .mr-cont-tooltip-window:not(.mr-modern-ui) #MrTitleBar > button:active .iconBtn { background-color: rgba(0, 0, 0, 0.55) !important; transform: scale(0.94) !important; }
