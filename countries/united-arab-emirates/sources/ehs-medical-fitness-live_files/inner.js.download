        //Star
        try {
            const starContainer = document.getElementById('star-container');
            const stars = starContainer.querySelectorAll('.star-btn');
            const ratingText = document.getElementById('rating-text');

            let currentRating = 0;
            let isLocked = false; // Flag to check if selection is submitted

            const labels = {
                1: 'Poor',
                2: 'Fair',
                3: 'Good',
                4: 'Very Good',
                5: 'Excellent'
            };

            function highlightStars(rating) {
                stars.forEach((star) => {
                    const value = parseInt(star.getAttribute('data-value'));
                    const svg = star.querySelector('svg');

                    if (value <= rating) {
                        svg.setAttribute('fill', 'currentColor');
                        svg.classList.add('fill-primary-600');
                        svg.classList.remove('fill-primary-600', 'fill-slate-300');
                    } else {
                        svg.setAttribute('fill', 'none');
                        svg.classList.add('fill-slate-300');
                        svg.classList.remove('fill-primary-600', 'fill-primary-600');
                    }
                });
            }

            stars.forEach((star) => {
                const starValue = parseInt(star.getAttribute('data-value'));

                // Hover effect (only if not locked)
                star.addEventListener('mouseenter', () => {
                    if (isLocked) return;
                    highlightStars(starValue);
                    ratingText.textContent = labels[starValue];
                });

                // Single click selection
                star.addEventListener('click', () => {
                    if (isLocked) return;

                    currentRating = starValue;
                    isLocked = true; // Lock the component

                    highlightStars(currentRating);
                    ratingText.textContent = `You rated: ${labels[currentRating]}`;

                    // Disable buttons visually and practically
                    stars.forEach(s => {
                        s.style.pointerEvents = 'none'; // Prevents further hover/click interactions
                        s.classList.remove('hover:scale-110'); // Remove scale animation
                    });
                });
            });

            // Mouse leave reset (only if not locked)
            starContainer.addEventListener('mouseleave', () => {
                if (isLocked) return;
                highlightStars(0);
                ratingText.textContent = '';
            });
            //Star end


        }
        catch (err) {
        }
      

