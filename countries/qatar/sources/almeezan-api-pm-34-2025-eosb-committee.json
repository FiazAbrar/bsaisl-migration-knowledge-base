],"subjects":[],"relevantAuthorities":[{"relationId":"c6bb95a8-3996-46bb-8006-a770af805fe3","relevantAuthorityId":"066ab1a7-5af6-40fe-b8b0-9da878f4b23d","relevantAuthorityTitle":"Not Exists"}],"files":[{"relationId":"9c5a5d3f-034a-49aa-bff0-44bdd1bacd55","fileId":"e2874301-4d6c-4c4c-b938-453eea59ea49","fileName":"12b9c68f-940f-4df0-ad8a-c150adbb5e23.pdf","filePath":"https://files.almeezan.gov.qa/almeezan/12b9c68f-940f-4df0-ad8a-c150adbb5e23.pdf","title":"نسخة الجريدة الرسمية","contentType":"application/pdf","fileSize":556211,"isPublish":true,"fileTypeId":"0d486df2-0aee-484b-8051-59bff8ebd57a","fileTypeTitle":"Official Gazette Issue","fileTypeTitleEnglish":"Official Gazette Issue","fileTypeCode":""}],"relatedLegislations":[],"canceledLegislationId":"00000000-0000-0000-0000-000000000000","sections":[{"id":"bb5c52dd-d2ba-4548-8cde-cc32f8968c0a","title":"المواد (1-10)","order":"00","isVersionedSection":false,"sections":[],"almawad":[{"id":"e99eb470-ad44-4655-9229-387aa7ab9331","title":"Article 1 ","description":"<div>\r\n\tتُنشأ بوزارة المالية لجنة تسمى&laquo;اللجنة المعنية بمشروع مكافأة نهاية الخدمة والمساهمات الأخرى للموظفين والعاملين بالدولة &raquo; وتُشكل برئاسة ممثل عن وزارة المالية ، وممثل عن مصرف قطر المركزي نائباً للرئيس ، وعضوية كل من:</div>\r\n<div>\r\n\t1.<span style=\"white-space:pre\"> </span>ممثل عن مكتب رئيس مجلس الوزراء .</div>\r\n<div>\r\n\t2.<span style=\"white-space:pre\"> </span>ممثل عن الأمانة العامة لمجلس الوزراء .</div>\r\n<div>\r\n\t3.<span style=\"white-space:pre\"> </span>ممثل عن وزارة المالية .</div>\r\n<div>\r\n\t4.<span style=\"white-space:pre\"> </span>ممثل عن وزارة التجارة والصناعة .</div>\r\n<div>\r\n\t5.<span style=\"white-space:pre\"> </span>ممثل عن وزارة العمل .</div>\r\n<div>\r\n\t6.<span style=\"white-space:pre\"> </span>ممثل عن ديوان الخدمة المدنية والتطوير الحكومي .</div>\r\n<div>\r\n\t7.<span style=\"white-space:pre\"> </span>ممثل عن المجلس الوطني للتخطيط .</div>\r\n<div>\r\n\t8.<span style=\"white-space:pre\"> </span>ممثل عن قطر للطاقة .</div>\r\n<div>\r\n\t9.<span style=\"white-space:pre\"> </span>ممثل عن جهاز قطر للاستثمار .</div>\r\n<div>\r\n\t10.<span style=\"white-space:pre\"> </span>ممثل عن مركز قطر للمال .</div>\r\n<div>\r\n\t11.<span style=\"white-space:pre\"> </span>ممثل عن غرفة تجارة وصناعة قطر .</div>\r\n<div>\r\n\t12.<span style=\"white-space:pre\"> </span>ثلاثة خبراء في أنظمة الادخار والاستثمار والتنفيذ ، يختارهم وزير المالية .</div>\r\n<div>\r\n\tوتختار كل جهة من يُمثلها في عضوية اللجنة ، على ألا تقل درجته عن مدير إدارة أو ما يعادلها، ويصدر بتسمية رئيس ونائب رئيس وأعضاء اللجنة قرار من وزير المالية .</div>\r\n<div>\r\n\tويتولى أمانة سر اللجنة موظف أو أكثر من موظفي وزارة المالية ، يصدر بندبهم وتحديد اختصاصاتهم ومكافآتهم قرار من الوزير .</div>\r\n<div>\r\n\t&nbsp;</div>\r\n","footerNote":"","oldTitle":"","oldDescription":null,"number":1,"order":0,"facet":"00.01","isPublish":true,"sectionTreeId":null,"publishDate":"2025-12-18T00:00:00","publishDateHijri":null,"effectiveDate":"2025-12-18T00:00:00","effectiveDateHijri":null,"cancelationDate":null,"cancelationDateHijri":null,"relationName":"","relationClass":"","relationCode":"","legislationId":"dbc9a2ff-f52a-4c2c-ad70-f62690033ba1","legislationNumber":"34","legislationYear":2025,"legislationTitle":null,"legislationTypeTitle":null,"toAlmadaId":null,"toAlmadaNumber":null,"toTitle":null,"toLegislationId":null,"toLegislationNumber":null,"toLegislationYear":null,"toLegislationTitle":null,"toLegislationTypeTitle":null,"parentAlmadaId":null,"parentAlmadaNumber":null,"parentTitle":null,"parentLegislationId":null,"parentLegislationNumber":null,"parentLegislationYear":null,"parentLegislationTitle":null,"parentLegislationDescription":null,"parentLegislationTypeTitle":null,"relatedAlmawad":[],"relationTypeForMada":null,"isAmended":false,"isAddition":false,"isCancel":false,"hasPreviousVersion":false,"additionOrder":0,"isVersionedMada":false,"hasRulings":false,"hasFatwas":false,"hasComparison":false,"hasAgreement":false,"hasLegislations":false,"hasAlmawadFiqhIjtihad":false,"relationNoteLegislationTitle":null,"relationNoteAlmadaDescription":null,"relationNoteLegislationNumber":null,"relationNoteLegislationYear":null,"relationNoteAlmadaNumber":null,"relationNoteLegislationId":null,"relationNoteAlmadaId":null,"sortDate":null,"chainPosition":0,"chainLength":null,"isOriginal":null,"isLatest":null,"hasHistory":false},{"id":"b46bcd3a-4c03-47e6-b63d-2364ce3e5fbf","title":"Article 2 ","description":"<div>\r\n\tتتولى اللجنة اقتراح نظام ادخاري استثماري لأموال الموظفين والعاملين من المواطنين الراغبين في ذلك ، والمقيمين في الدولة ، والإشراف عليه بعد إقراره من مجلس الوزراء ، يعتمد على استثمار مكافأة نهاية الخدمة للموظف غير القطري وأية مساهمات أخرى ، بهدف تشجيع المواطنين والمقيمين على استثمارها ، واستقطاب الكفاءات الماهرة من المقيمين والإبقاء عليهم.</div>\r\n<div>\r\n\tوللجنة ، في سبيل ذلك ، مباشرة كافة المهام والصلاحيات ، وبوجه خاص ما يلي :</div>\r\n<div>\r\n\t1.<span style=\"white-space:pre\"> </span>اقتراح القواعد والمعايير المناسبة لتقديم برنامج ادخار طوعي للمواطنين القطريين ، والعمل على تنفيذها ، وذلك دون الإخلال بأي من النظم الوظيفية أو أنظمة التقاعد المقررة قانوناً .</div>\r\n<div>\r\n\t2.<span style=\"white-space:pre\"> </span>التنسيق مع كافة الجهات الحكومية وغير الحكومية لدى إعداد القواعد والضوابط والآلية اللازمة للنظام المشار إليه ، بما يضمن شموليته كافة الفئات المستهدفة ، وتقديم الدعم اللازم لذلك بما يتفق والقوانين والأنظمة المعمول بها في الدولة.</div>\r\n<div>\r\n\t3.<span style=\"white-space:pre\"> </span>إجراء الحصر الشامل لكافة الموظفين والعاملين بالدولة الذين سيشملهم النظام ، وإجمالي المبالغ المتوقع صرفها كمكافأة نهاية خدمة لهم ، بالتنسيق مع الجهات المعنية.</div>\r\n<div>\r\n\t4.<span style=\"white-space:pre\"> </span>اقتراح القواعد والمعايير التي تُحدد نطاق سريان هذا النظام على أي من فئات الموظفين أو العاملين بالدولة .</div>\r\n<div>\r\n\t5.<span style=\"white-space:pre\"> </span>اقتراح سبل التوعية المجتمعية بمزايا هذا النظام ، وبيان أهدافه ، وأهمية الاشتراك والتسجيل فيه ، كأحد السبل الجاذبة للاستثمار داخل الدولة، والعمل على تنفيذ تلك السبل التوعوية ، وتبسيط الإجراءات المتبعة للتسجيل وإدراج المشتركين فيه.</div>\r\n<div>\r\n\t6.<span style=\"white-space:pre\"> </span>العمل على تنفيذ ومتابعة النظام المشار إليه ، فور إقراره من مجلس الوزراء .</div>\r\n<div>\r\n\t7.<span style=\"white-space:pre\"> </span>اتخاذ إجراءات التعاقد مع أي من الجهات أو الشركات العاملة في مجال الاستثمار، للقيام بتنفيذ برنامج ادخار واستثمار أموال الموظفين والعاملين بالدولة ، وتضمين هذا التعاقد كافة الضمانات اللازمة وتوفير العدد الكافي من الخبراء والاستشاريين ، بما يضمن كفاءته ، والإشراف على هذا التنفيذ .</div>\r\n<div>\r\n\t8.<span style=\"white-space:pre\"> </span>اقتراح الضمانات الأخرى اللازمة لحماية وتعزيز حقوق الموظفين والعاملين بالدولة ، فيما يتعلق بمستحقاتهم من مكافآت نهاية الخدمة والعمل على تنفيذها .</div>\r\n<div>\r\n\t9.<span style=\"white-space:pre\"> </span>إجراء التقييم الدوري لهذا النظام ، والعمل على تذليل كافة العقبات التي تحول دون تحقيق الأهداف التي أنشئ من أجلها .</div>\r\n<div>\r\n\t10.<span style=\"white-space:pre\"> </span>أية مهام أخرى يكلفها بها رئيس مجلس الوزراء .</div>\r\n<div>\r\n\t&nbsp;</div>\r\n","footerNote":"","oldTitle":"","oldDescription":null,"number":2,"order":0,"facet":"00.02","isPublish":true,"sectionTreeId":null,"publishDate":"2025-12-18T00:00:00","publishDateHijri":null,"effectiveDate":"2025-12-18T00:00:00","effectiveDateHijri":null,"cancelationDate":null,"cancelationDateHijri":null,"relationName":"","relationClass":"","relationCode":"","legislationId":"dbc9a2ff-f52a-4c2c-ad70-f62690033ba1","legislationNumber":"34","legislationYear":2025,"legislationTitle":null,"legislationTypeTitle":null,"toAlmadaId":null,"toAlmadaNumber":null,"toTitle":null,"toLegislationId":null,"toLegislationNumber":null,"toLegislationYear":null,"toLegislationTitle":null,"toLegislationTypeTitle":null,"parentAlmadaId":null,"parentAlmadaNumber":null,"parentTitle":null,"parentLegislationId":null,"parentLegislationNumber":null,"parentLegislationYear":null,"parentLegislationTitle":null,"parentLegislationDescription":null,"parentLegislationTypeTitle":null,"relatedAlmawad":[],"relationTypeForMada":null,"isAmended":false,"isAddition":false,"isCancel":false,"hasPreviousVersion":false,"additionOrder":0,"isVersionedMada":false,"hasRulings":false,"hasFatwas":false,"hasComparison":false,"hasAgreement":false,"hasLegislations":false,"hasAlmawadFiqhIjtihad":false,"relationNoteLegislationTitle":null,"relationNoteAlmadaDescription":null,"relationNoteLegislationNumber":null,"relationNoteLegislationYear":null,"relationNoteAlmadaNumber":null,"relationNoteLegislationId":null,"relationNoteAlmadaId":null,"sortDate":null,"chainPosition":0,"chainLength":null,"isOriginal":null,"isLatest":null,"hasHistory":false},{"id":"bce769db-e0e2-4f2e-ace3-bb485fd3b579","title":"Article 3 ","description":"<p>\r\n\tتجتمع اللجنة بدعوة من رئيسها ، مرتين على الأقل كل شهر ، وكلما دعت الحاجة&nbsp; إلى ذلك ، ولا تكون اجتماعاتها صحيحة إلا بحضور أغلبية أعضائها ، على أن يكون من بينهم الرئيس أو نائبه ، وتصدر قراراتها وتوصياتها بأغلبية أصوات الأعضاء الحاضرين وعند التساوي في الأصوات يُرجح الجانب الذي منه رئيس الاجتماع.</p>\r\n","footerNote":"","oldTitle":"","oldDescription":null,"number":3,"order":0,"facet":"00.03","isPublish":true,"sectionTreeId":null,"publishDate":"2025-12-18T00:00:00","publishDateHijri":null,"effectiveDate":"2025-12-18T00:00:00","effectiveDateHijri":null,"cancelationDate":null,"cancelationDateHijri":null,"relationName":"","relationClass":"","relationCode":"","legislationId":"dbc9a2ff-f52a-4c2c-ad70-f62690033ba1","legislationNumber":"34","legislationYear":2025,"legislationTitle":null,"legislationTypeTitle":null,"toAlmadaId":null,"toAlmadaNumber":null,"toTitle":null,"toLegislationId":null,"toLegislationNumber":null,"toLegislationYear":null,"toLegislationTitle":null,"toLegislationTypeTitle":null,"parentAlmadaId":null,"parentAlmadaNumber":null,"parentTitle":null,"parentLegislationId":null,"parentLegislationNumber":null,"parentLegislationYear":null,"parentLegislationTitle":null,"parentLegi