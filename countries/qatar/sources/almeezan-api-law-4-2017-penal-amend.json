b47b22","fileId":"abd91c9a-9cd5-4869-ab56-b8046351dd94","fileName":"7735b900-15d4-497a-ab17-f8095745346e.pdf","filePath":"https://files.almeezan.gov.qa/almeezan/7735b900-15d4-497a-ab17-f8095745346e.pdf","title":"نسخة من الجريدة الرسمية","contentType":"application/pdf","fileSize":40931,"isPublish":true,"fileTypeId":"0d486df2-0aee-484b-8051-59bff8ebd57a","fileTypeTitle":"Official Gazette Issue","fileTypeTitleEnglish":"Official Gazette Issue","fileTypeCode":""},{"relationId":"0f65f26b-feb8-45e5-9021-40e6e81c7f15","fileId":"bdb6e25d-e52e-4704-bd07-a88a00e48ef1","fileName":"توقيعات - تميم بن حمد آل...","filePath":"https://files.almeezan.gov.qa/almeezan/law/7192/attachment_14884.html","title":"توقيعات - تميم بن حمد آل...","contentType":"text/html; charset=utf-8","fileSize":0,"isPublish":true,"fileTypeId":"39275772-d296-47e4-8e34-eec854219adf","fileTypeTitle":"Appendix","fileTypeTitleEnglish":"Appendix","fileTypeCode":""}],"relatedLegislations":[],"canceledLegislationId":"00000000-0000-0000-0000-000000000000","sections":[{"id":"75ef2b16-3bfb-4f82-8282-7bfdf1fc8f21","title":"المواد (1-2)","order":"01","isVersionedSection":false,"sections":[],"almawad":[{"id":"df642744-49bc-4a4b-b22e-9652292c2acf","title":"Article 1 ","description":"يُستبدل بنص المادة (<a target='_top' href='/legislations/415d8273-12e0-4e2c-aa02-5c0bf0a5c53c?almawadId=17c1cf67-afb6-44df-8fd3-915c40f6188a'>333</a>) من قانون العقوبات المشار إليه، النص التالي:<BR><a target='_top' href='/legislations/415d8273-12e0-4e2c-aa02-5c0bf0a5c53c?almawadId=17c1cf67-afb6-44df-8fd3-915c40f6188a'>مادة (333)</a>:<BR>\"يُعاقب بالحبس مدة لا تجاوز سنتين، وبالغرامة التي لا تزيد على (10,000) عشرة آلاف ريال، أو بإحدى هاتين العقوبتين، كل من اعتدى على حرمة الحياة الخاصة للأفراد، بغير رضائهم في غير الأحوال المصرح بها قانوناً، وذلك بارتكاب أحد الأفعال الآتية:<BR>1- فض رسالة أو برقية خاصة موجهة لغيره من الأفراد.<BR>2- استرق السمع في مكالمة هاتفية.<BR>3- سجل أو نقل محادثات جرت في مكان خاص، عن طريق جهاز أياً كان نوعه.<BR>4- التقط أو نقل صوراً أو مقاطع فيديو لفرد أو أفراد في مكان خاص، عن طريق جهاز أياً كان نوعه.<BR>ويعاقب بذات العقوبة المنصوص عليها في الفقرة السابقة كل من:<BR>1- التقط أو نقل صوراً أو مقاطع فيديو لفرد أو أفراد في مكان عام، عن طريق جهاز أياً كان نوعه، بقصد استخدامها في الإساءة أو التشهير.<BR>2- التقط أو نقل صوراً أو مقاطع فيديو للمصابين أو المتوفين في الحوادث، عن طريق جهاز أياً كان نوعه، في غير الأحوال المصرح بها قانوناً.\".","footerNote":"","oldTitle":"","oldDescription":null,"number":1,"order":0,"facet":"01","isPublish":true,"sectionTreeId":null,"publishDate":"2017-03-30T00:00:00","publishDateHijri":"02/07/1438","effectiveDate":"2017-03-30T00:00:00","effectiveDateHijri":"02/07/1438","cancelationDate":null,"cancelationDateHijri":null,"relationName":"","relationClass":"","relationCode":"","legislationId":"7df82212-cbf2-4d11-837c-c9c3413262ce","legislationNumber":"4","legislationYear":2017,"legislationTitle":null,"legislationTypeTitle":null,"toAlmadaId":null,"toAlmadaNumber":null,"toTitle":null,"toLegislationId":null,"toLegislationNumber":null,"toLegislationYear":null,"toLegislationTitle":null,"toLegislationTypeTitle":null,"parentAlmadaId":null,"parentAlmadaNumber":null,"parentTitle":null,"parentLegislationId":null,"parentLegislationNumber":null,"parentLegislationYear":null,"parentLegislationTitle":null,"parentLegislationDescription":null,"parentLegislationTypeTitle":null,"relatedAlmawad":[],"relationTypeForMada":null,"isAmended":false,"isAddition":false,"isCancel":false,"hasPreviousVersion":false,"additionOrder":0,"isVersionedMada":false,"hasRulings":false,"hasFatwas":false,"hasComparison":false,"hasAgreement":false,"hasLegislations":false,"hasAlmawadFiqhIjtihad":false,"relationNoteLegislationTitle":null,"relationNoteAlmadaDescription":null,"relationNoteLegislationNumber":null,"relationNoteLegislationYear":null,"relationNoteAlmadaNumber":null,"relationNoteLegislationId":null,"relationNoteAlmadaId":null,"sortDate":null,"chainPosition":0,"chainLength":null,"isOriginal":null,"isLatest":nu