   "almawad": [
    {
     "id": "f0b08765-ad0a-445c-bb83-e044219a7a23",
     "title": "Article 1 ",
     "description": "<div>\r\n\tيُستبدل بنصي المادتين (<a href='/legislations/b888bddf-b8ea-4380-9dce-005dafbad2fa?almawadId=8e79e264-7894-495d-8438-ed35bec92022'>21</a>)، (<a href='/legislations/b888bddf-b8ea-4380-9dce-005dafbad2fa?almawadId=04f0b9e4-fd0e-4e9c-8eda-ed31634ecc7e'>23</a>) من <a href='/legislations/b888bddf-b8ea-4380-9dce-005dafbad2fa'>القانون رقم (21) لسنة 2015</a> المشار إليه، النصان التاليان:</div>\r\n<div>\r\n\t&zwnj;مادة&zwnj; &zwnj;(&zwnj;21&zwnj;):&zwnj;</div>\r\n<div>\r\n\t&zwnj;&quot;للوافد&zwnj; &zwnj;للعمل&zwnj; &zwnj;أن&zwnj; &zwnj;ينتقل&zwnj; &zwnj;للعمل&zwnj; &zwnj;لدى&zwnj; &zwnj;صاحب&zwnj; &zwnj;عمل&zwnj; &zwnj;آخر،&zwnj; &zwnj;وفقاً&zwnj; &zwnj;للقواعد&zwnj; &zwnj;والإجراءات&zwnj; &zwnj;التي&zwnj; &zwnj;حددها&zwnj; &zwnj;وزارة&zwnj; &zwnj;التنمية&zwnj; &zwnj;الإدارية&zwnj; &zwnj;والعمل&zwnj; &zwnj;والشؤون&zwnj; &zwnj;الاجتماعية&zwnj;.&quot;.&zwnj; &zwnj;</div>\r\n<div>\r\n\tمادة&zwnj; &zwnj;(&zwnj;23&zwnj;)&zwnj;:</div>\r\n<div>\r\n\t&zwnj;&quot;يُحظّر&zwnj; &zwnj;على&zwnj; &zwnj;أي&zwnj; &zwnj;شخص&zwnj; &zwnj;طبيعي&zwnj; &zwnj;أو&zwnj; &zwnj;معنوي&zwnj; &zwnj;استخدام&zwnj; &zwnj;وافدين&zwnj; &zwnj;دون&zwnj; &zwnj;إبرام&zwnj; &zwnj;عقد&zwnj; &zwnj;عمل&zwnj;،&zwnj; &zwnj;أو&zwnj; &zwnj;استخدام&zwnj; &zwnj;الوافدين&zwnj; &zwnj;الذين&zwnj; &zwnj;يستقدمهم&zwnj; &zwnj;للعمل&zwnj; &zwnj;لديه&zwnj; &zwnj;للعمل&zwnj; &zwnj;لدى&zwnj; &zwnj;جهات&zwnj; &zwnj;أخرى&zwnj;.&zwnj; &zwnj;</div>\r\n<div>\r\n\tواستثناءً&zwnj; &zwnj;من&zwnj; &zwnj;ذلك&zwnj;،&zwnj; &zwnj;يجوز&zwnj; &zwnj;لوزارة&zwnj; &zwnj;التنمية&zwnj; &zwnj;الإدارية&zwnj; &zwnj;والعمل&zwnj; &zwnj;والشؤون&zwnj; &zwnj;الاجتماعية&zwnj; &zwnj;أن&zwnj; &zwnj;تأذن&zwnj; &zwnj;للمستقدم&zwnj; &zwnj;بإعارة&zwnj; &zwnj;عمالة&zwnj; &zwnj;الوافدين&zwnj; &zwnj;إلى&zwnj; &zwnj;صاحب&zwnj; &zwnj;عمل&zwnj; &zwnj;آخر&zwnj; &zwnj;للعمل&zwnj; &zwnj;لديه&zwnj; &zwnj;مدة&zwnj; &zwnj;لا&zwnj; &zwnj;تجاوز&zwnj; &zwnj;ستة&zwnj; &zwnj;أشهر&zwnj; &zwnj;قابلة&zwnj; &zwnj;للتجديد&zwnj; &zwnj;لمدة&zwnj; &zwnj;أخرى&zwnj; &zwnj;مماثلة.&zwnj;</div>\r\n<div>\r\n\t&zwnj;كما&zwnj; &zwnj;يجوز&zwnj; &zwnj;لها&zwnj; &zwnj;أن&zwnj; &zwnj;تأذن&zwnj; &zwnj;للوافد&zwnj; &zwnj;بالعمل&zwnj; &zwnj;بعض&zwnj; &zwnj;الوقت&zwnj; &zwnj;لدى&zwnj; &zwnj;جهة&zwnj; &zwnj;عمل&zwnj; &zwnj;أخرى&zwnj; &zwnj;بالإضافة&zwnj; &zwnj;إلى&zwnj; &zwnj;عمله&zwnj; &zwnj;الأصلي&zwnj;.&zwnj; &zwnj;وفي&zwnj; &zwnj;جميع&zwnj; &zwnj;الأحوال&zwnj;،&zwnj; &zwnj;يجب&zwnj; &zwnj;الحصول&zwnj; &zwnj;على&zwnj; &zwnj;موافقة&zwnj; &zwnj;المستقدم&zwnj; &zwnj;والوافد&zwnj; &zwnj;للعمل&zwnj;.&quot;.&zwnj;&nbsp;</div>\r\n",
